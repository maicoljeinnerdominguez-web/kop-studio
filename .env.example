# Database (PostgreSQL)
# Local dev: postgresql://kopstudio:password@localhost:5432/kopstudio
# Railway: provided automatically via DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/kopstudio

# Public URL of the store (used for SEO links, sitemap and Wompi redirects)
SITE_URL=https://kopstudio.com

# Auth — REQUIRED in production: long random string used to sign session cookies
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# First admin (used only by /api/setup/seed when no admin exists yet).
# If ADMIN_PASSWORD is empty, a random password is generated and shown once.
ADMIN_EMAIL=admin@kopstudio.com
ADMIN_PASSWORD=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Wompi Payments (get from wompi.co)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Online payment is enabled when WOMPI_PUBLIC_KEY and WOMPI_INTEGRITY_KEY are set.
# Webhook URL to register in Wompi: https://<your-domain>/api/payments/wompi/webhook
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=test

# Email (Resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@kopstudio.com

# Optional: Cloudinary for image hosting
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=